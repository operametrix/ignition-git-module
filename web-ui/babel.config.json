{
    "presets": [
        "@babel/preset-env",
        [
            "@babel/preset-react",
            {
                "_comment": "classic: JSX compiles to React.createElement, so the bundle uses the react external instead of pulling react/jsx-runtime in as a second copy",
                "runtime": "classic"
            }
        ],
        "@babel/preset-typescript"
    ],
    "plugins": [
        [
            "@babel/plugin-transform-runtime",
            {
                "regenerator": true
            }
        ]
    ],
    "env": {
        "test": {
            "presets": [
                ["@babel/preset-env", {
                    "targets": "current node"
                }]
            ]
        }
    }
}
